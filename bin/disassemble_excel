#!/usr/bin/env zsh
# disassemble_excel — extract Excel (.xlsx/.xlsm) sheets, formulas and VBA macro
# source into a directory of diffable text files. Go implementation at:
#   ~/dotfiles/src/disassemble_excel/
# 再ビルドは同期 (bin/parallel-each と同じ理由)。機構は bin/lib/go_autobuild.zsh。

set -u

source "${0:A:h}/lib/go_autobuild.zsh"
go_autobuild_exec "${0:A:h}/../src/disassemble_excel" disassemble_excel -- "$@"
