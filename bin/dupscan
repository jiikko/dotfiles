#!/usr/bin/env zsh
# dupscan — repo の中で本体が同じ形のメソッド (関数・初期化子・クロージャ) を構文木で見つけて組にする。
# Go implementation at:
#   ~/dotfiles/src/dupscan/
#     dupscan [report] [-format text|json|xcode] [-limit N] [dir ...]
#     dupscan gate | near | explain | index | callers  (使い方は src/dupscan/README.md・Claude の手順は skill dupscan)
# 調べる repo には何も書かない。初回は cgo で文法の C のソースをビルドするので時間がかかる。
set -u
source "${0:A:h}/lib/go_autobuild.zsh"
# 温め検査が呼び出しを静的に列挙するため、起点とツール名を引数配列に隠さない。
if [[ "${1-}" == "-no-build" ]]; then
  shift
  go_autobuild_exec --no-build "${0:A:h}/../src/dupscan" dupscan -- "$@"
else
  go_autobuild_exec "${0:A:h}/../src/dupscan" dupscan -- "$@"
fi
