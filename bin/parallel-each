#!/usr/bin/env zsh
# parallel-each — run a command template over each line of a file in parallel,
# with an interactive TUI. Go implementation at:
#   ~/dotfiles/src/parallel-each/
# 再ビルドは同期 (--async にしない): 出力を人/スクリプトが消費するため、旧版の結果を
# 新コードの結果と誤認させない。機構は bin/lib/go_autobuild.zsh。

set -u

source "${0:A:h}/lib/go_autobuild.zsh"
go_autobuild_exec "${0:A:h}/../src/parallel-each" parallel-each -- "$@"
