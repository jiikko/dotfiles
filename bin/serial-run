#!/usr/bin/env zsh
# serial-run — 重いコマンド (make test / xcodebuild 等) を順番待ちにし、同時には 1 本だけ走らせる (既定は repo ごと。SERIAL_RUN_SCOPE=machine でマシン全体)。
# Go implementation at:
#   ~/dotfiles/src/serialrun/
#     serial-run [-l <lock名>] [--max-wait <秒>] -- <コマンド> [引数…]
#     serial-run status
# Claude Code の session が打つ重いコマンドは、PreToolUse hook (_claude/hooks/serial-run-wrap.sh) が自動でこれに包む。
# 再ビルドは同期 (--async にしない): 排他の判定を出す道具なので、旧版が「取れた」を返して走り出すのを避ける。
# 🚨 ビルドの段と実行の段を分ける。go_autobuild_exec はビルドに失敗すると rc=1 で抜けるので、そのまま通すと
#    包んだ make test の失敗 (rc=1) と見分けられない。ビルドの失敗は 125 (道具の失敗) にする。
# SERIAL_RUN_FAIL_OPEN=1 (bin/lib/serial_run_shim.sh の PATH shim が付ける): ビルドできないときは 125 で落ちずに、-- の後のコマンドを順番を待たずに実行する。
#    shim は exec した後に 125 を「道具の失敗」と「包んだコマンドの失敗」に分けられないので、道具が壊れた日にも swift / xcodebuild が動くようにここで逃がす。
#    子へは渡さない (子の中で打った serial-run まで、壊れた日に順番を待たなくなる)
set -u
fail_open=${SERIAL_RUN_FAIL_OPEN:-}
unset SERIAL_RUN_FAIL_OPEN
source "${0:A:h}/lib/go_autobuild.zsh"
src="${0:A:h}/../src/serialrun"
( go_autobuild_exec "$src" serial-run -- __ready ) </dev/null >/dev/null || {
  print -u2 -- "serial-run: ビルドできない (${src:A})"
  if [[ -n $fail_open ]] && (( ${@[(i)--]} < $# )); then
    print -u2 -- "serial-run: 🚨 順番を待たずに実行する (SERIAL_RUN_FAIL_OPEN)"
    exec "${@[${@[(i)--]}+1,-1]}"
  fi
  exit 125
}
exec "${src:A}/serial-run" "$@"
