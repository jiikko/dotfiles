#!/bin/bash
# mutate-verify-list — 呼び口。本体は devtool/bin/mutate-verify-list (使い方・終了コードは本体の冒頭)。
# dotfiles の道具 (runtimeout・skill-tmpdir) を bin/devtool-run が解決して渡すので、本体を直接起こさない。
set -u
unset CDPATH
_self="$(readlink -f "${BASH_SOURCE[0]}")" || { echo "mutate-verify-list: 実体を解決できない: ${BASH_SOURCE[0]}" >&2; exit 2; }
# 起こされた bash のまま起こす (devtool-run が本体も同じ bash で起こす。`bash5 bin/mutate-verify-list` の選択を本体まで保つ)
exec "$BASH" "$(dirname "$_self")/devtool-run" mutate-verify-list "$@"
