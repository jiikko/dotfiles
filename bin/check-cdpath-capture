#!/usr/bin/env bash
# check-cdpath-capture — `$(cd …)` でパスを取る前に CDPATH を外していない行を落とす (どの repo でも使える)。
#
# なぜ:
#   CDPATH が export された環境では、相対パスへの cd が CDPATH の要素 (`.` を含む) で解決すると、
#   解決先を stdout に出す。`ROOT="$(cd "$(dirname "$0")/.." && pwd)"` はパスを 2 行持ち、後続のパスが全部壊れる。
#   CI は CDPATH を export しないので、手元でだけ壊れる。dotfiles では tests/bin の 25 本 (2026-10-07)、
#   my-products の vlc-multi-video-player では 7 本 (2026-11-05。`make lint` と `vgp-client` が壊れた) が規約 (`unset CDPATH`) から漏れていた。
#
# 使い方:
#   check-cdpath-capture [--min N] [--exclude <glob>]... [<repo>]
#     <repo> (既定: cwd の repo) の git が知っているファイル (追跡しているもの + ignore されていない未追跡) のうち、
#     shell script (*.sh / *.bash / *.zsh / *.bats、または 1 行目が sh・bash・zsh・dash・ksh の shebang) を全部見る。
#     work tree で消したファイルは飛ばす。symlink は飛ばす (実体は別の名前で一覧に載る)。
#     見つけた数が N (既定 1) 未満なら、対象を探せていないとして落とす。
#     --exclude は repo からの相対パスに bash の glob で当てて外す (`vendor/*` のような他人のコード。`*` は / も跨ぐ)。何本でも渡せる。
#     どのファイルにも当たらない --exclude は落とす (書き損じ・消えたディレクトリの除外が黙って残るため)。
#   CHECK_CDPATH_FILES に改行区切りの一覧を渡すと、探さずにそれだけを見る (dotfiles の scripts/check_cdpath_before_cd_capture.sh が使う)。
#     一覧の相対パスは <repo> から読む。一覧にあるのにファイルでないものは落とす (渡す側の壊れ)。
# 終了コード: 0 = 該当なし / 1 = 該当あり・検査できない / 2 = 使い方の誤り
#
# 🚨 脅威モデル: 止めるのは「`$(cd` を書いたのに CDPATH を外し忘れた」うっかりだけ。意図的な迂回は review の責務。
# 合格の形 (どちらか):
#   - その置換より前に、コマンドの位置で `unset CDPATH` (`-v` / `--` も可) か `CDPATH=` (空の代入) を書いている (実行ファイルの形)。
#     同じ行なら置換より左にあること。行末コメント・文字列の中の「unset CDPATH」は数えない
#   - その行の置換が `$(CDPATH='' cd …)` / `$(CDPATH= cd …)` (source される lib の形。unset すると呼び出し側の環境まで変える)
# 意図的な例外は行内に `cdpath: allow` を書く (理由も添える)。
# 🚨 検出しないと決めた形:
#   - 置換の外の cd (`cd "$d" || exit 1`)。出力を取り込まないので壊れない (端末に 1 行出るだけ)
#   - バッククォートの `` `cd …` `` / `$(builtin cd` / `$(command cd` / 変数・eval 経由 (2026-10-07 時点で対象に 0 件)
#   - `unset CDPATH` が関数の中にあり、その関数が置換より後に呼ばれる形 (行の順だけを見る)
#   - コメント行 (先頭が #) の中の `$(cd`
#   - 複数行にまたがる置換 (`$(` の後で改行・行継続してから cd) / `$(set -e; cd …)` のように cd の前に別のコマンドを置く形 /
#     `$(CDPATH=. cd …)` のような非空の前置代入 (2026-10-07 時点で対象に 0 件)
#   - unset のスコープ・順序: サブシェルや if の中の unset もファイル全体の免除に数える / unset の後で CDPATH を設定し直す形
#   - zsh の小文字の `cdpath` だけを外す形 (`unset CDPATH` を書けば通る)
#   - Makefile のレシピの `$$(cd …)` (make の子の sh も CDPATH を継承するので壊れるが、shell script ではないので見ない)
#   - 1 行目が BOM で始まる shebang、shebang も拡張子も無い source 用のファイル (.envrc など)
#   - 拡張子の無い mksh・yash・posh・oksh・osh の shebang (利用が稀)。逆に、他の言語の shebang の引数に /bin/sh があると拾う (偽陽性。現実にはまず無い)
#   - symlink の先 (飛ばす。先が repo の外や submodule だと、どこでも検査されない)
#   - 引用文字列の中身は区別しない: 文字列の中の ` #` 以降をコメントとして捨てる (同じ行の後ろの置換を見落とす) /
#     文字列の中の `; unset CDPATH` や `echo todo unset CDPATH` を外したものと数える。字句の判定は直すたびに別の迂回が出る。
#     うっかりの書き漏れでこの形になることは稀なので、ここで打ち切る
# 🚨 検出してしまうと受け入れた形 (偽陽性): `$(cd ..)` / `$(cd /abs)` / `$(cd ./x)` は CDPATH を見ないので壊れないが落とす。
#   「$(cd を書いたら CDPATH を外す」を一律の規則にした方が、どの形が安全かを書く人に判断させるより単純なため。`cdpath: allow` で通す
#
# shellcheck disable=SC2016  # 案内文の $(cd …) は展開させない文字列
set -uo pipefail
unset CDPATH

die() { printf '✗ check-cdpath-capture: %s\n' "$1" >&2; exit "${2:-1}"; }
usage() { sed -n '2,/^# 終了コード/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

min=1
repo=""
excludes=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --min) [ $# -ge 2 ] || die "--min に数が要る" 2; min="$2"; shift 2 ;;
    --min=*) min="${1#--min=}"; shift ;;
    --exclude) [ $# -ge 2 ] && [ -n "$2" ] || die "--exclude に glob が要る" 2; excludes+=("$2"); shift 2 ;;
    --exclude=*) [ -n "${1#--exclude=}" ] || die "--exclude に glob が要る" 2; excludes+=("${1#--exclude=}"); shift ;;
    -*) die "知らない引数: $1" 2 ;;
    *) [ -z "$repo" ] || die "repo は 1 つだけ渡す: $1" 2; repo="$1"; shift ;;
  esac
done

_self="$(readlink -f "${BASH_SOURCE[0]}")" || die "実体を解決できない: ${BASH_SOURCE[0]}"
# shellcheck source=bin/lib/uint.sh
. "$(dirname "$_self")/lib/uint.sh" || die "$(dirname "$_self")/lib/uint.sh を読めない"
# shellcheck source=bin/lib/git_location_env.sh
. "$(dirname "$_self")/lib/git_location_env.sh" || die "$(dirname "$_self")/lib/git_location_env.sh を読めない"
uint_ok "$min" 6 || die "--min は 6 桁までの 0 以上の整数: $min" 2

if [ -n "${CHECK_CDPATH_FILES:-}" ] && [ -z "$repo" ]; then
  repo="$PWD"
else
  # 継承した GIT_DIR が別の repo を指すと、cwd ではなくそちらのファイルを数える
  git_location_env_unset || die "継承した git の場所の環境変数 (GIT_DIR など) を外せない"
  repo="$(git -C "${repo:-.}" rev-parse --show-toplevel 2>/dev/null)" || die "git の repo の中で打つか、repo を渡す: ${repo:-$PWD}" 2
fi
cd "$repo" || die "repo へ移れない: $repo"

is_shell() {  # $1=ファイル
  case "$1" in
    *.sh|*.bash|*.zsh|*.bats) return 0 ;;
  esac
  local first
  IFS= read -r first < "$1" 2>/dev/null || return 1
  # 版つきの名前 (bash5・bash-5.2) と bats・ash も拾う
  [[ "$first" =~ ^\#!.*[/\ ](sh|bash|zsh|dash|ksh|ash|bats)[0-9.-]*([[:space:]]|$) ]]
}

if [ -n "${CHECK_CDPATH_FILES:-}" ]; then
  files_raw="$CHECK_CDPATH_FILES"
else
  listing="$(git ls-files -z --cached --others --exclude-standard | tr '\0' '\n')" || die "git ls-files が失敗した。検査できないので緑にしない"
  files_raw=""
  used=()
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    skip=0
    for i in "${!excludes[@]}"; do
      # shellcheck disable=SC2053  # glob として当てる
      if [[ "$f" == ${excludes[$i]} ]]; then skip=1; used[i]=1; fi
    done
    [ "$skip" -eq 0 ] || continue
    is_shell "$f" && files_raw+="$f"$'\n'
  done <<< "$listing"
  for i in "${!excludes[@]}"; do
    [ -n "${used[i]:-}" ] || die "--exclude ${excludes[$i]} がどのファイルにも当たらない (書き損じか、消えたディレクトリ)"
  done
fi

n_files=0
bad=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  # 一覧にあるのにファイルでないものは、渡す側の壊れ。黙って飛ばすと一部しか検査せずに緑になる
  [ -f "$f" ] || die "一覧にあるがファイルでない: $f (検査できないので緑にしない)"
  [ -r "$f" ] || die "読めないファイル: $f (検査できないので緑にしない)"
  n_files=$((n_files + 1))
  # 行の順に読み、CDPATH を外す前の `$(cd` を出す。awk の失敗は「検査できなかった」として止める。
  # awk へはファイル名でなく stdin で渡す: 名前が `a=b.sh` なら変数の代入、`-` なら stdin (= 外の here-string の一覧の残り) と読まれ、
  # そのファイルと一覧の残りを検査せずに緑になる
  # 外す形はコマンドの位置 (行頭か ; & | ( { then do else の後) に限る。文字列・行末コメントの中の語を数えないため。
  # `CDPATH=` は単独の代入 (後ろが行末か ; & |) だけを数える。`$(CDPATH='' cd …)` の前置代入はその置換にしか効かない
  hits="$(awk '
    /^[[:space:]]*#/ { next }
    {
      code = $0
      sub(/[[:space:]]#.*$/, "", code)
      # unset と空の代入を別々に探し、左にある方を採る (片方だけ探すと、後ろの unset が前の CDPATH= を隠す)
      upos = 0
      if (match(code, /(^|[;&|({]|then|do|else)[[:space:]]*unset([[:space:]]+(-v|--))*[[:space:]]+([A-Za-z_][A-Za-z0-9_]*[[:space:]]+)*CDPATH([[:space:];&|)]|$)/)) upos = RSTART
      if (match(code, /(^|[;&|({]|then|do|else)[[:space:]]*CDPATH=[\047"]?[\047"]?[[:space:]]*($|[;&|])/) && (!upos || RSTART < upos)) upos = RSTART
      cpos = match(code, /\$\([[:space:]]*cd[[:space:]]/) ? RSTART : 0
      if (cpos && !seen && !(upos && upos < cpos) && index($0, "cdpath: allow") == 0) print FNR ": " $0
      if (upos) seen = 1
    }
  ' < "$f")" || die "awk が $f で失敗した。検査できないので緑にしない"
  if [ -n "$hits" ]; then
    while IFS= read -r h; do printf '%s:%s\n' "$f" "$h"; done <<< "$hits"
    bad=1
  fi
done <<< "$files_raw"

[ "$n_files" -ge "$min" ] || die "検査対象が ${n_files} 件しかない (下限 ${min}。対象を探せていない)。緑にしない"
if [ "$bad" -ne 0 ]; then
  printf '✗ 上の行は CDPATH を外さずに $(cd …) でパスを取っている。ファイルの先頭 (set の直後) に unset CDPATH を置くか、\n'
  printf '  source される lib なら $(CDPATH='"''"' cd …) にする。意図的なら行に cdpath: allow と理由を書く\n'
  exit 1
fi
printf '✓ CDPATH を外さない $(cd …): %d ファイルに該当なし\n' "$n_files"
