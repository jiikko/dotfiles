#!/usr/bin/env zsh
# tmpclean — 一時領域 (Claude Code の scratchpad・$TMPDIR) を数え、承認された古いものだけをゴミ箱へ移す。
# Go implementation at:
#   ~/dotfiles/src/tmpclean/
#     tmpclean count | plan -kinds session,tmpdir -out <dir> | apply -plan <file> -approve <ID>   (使い方は tmpclean -h)
# 手順 (数える → 候補を見せる → 承認 → 移す) は skill cleanup-tmp-dir。
# 再ビルドは同期 (--async にしない): 呼び出し側は出力と rc で判定するので、旧版の結果を新版のものと誤認させない。
set -u
source "${0:A:h}/lib/go_autobuild.zsh"
go_autobuild_exec --pkg cmd/tmpclean "${0:A:h}/../src/tmpclean" tmpclean -- "$@"
