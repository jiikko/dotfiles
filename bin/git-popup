#!/usr/bin/env zsh
# git-popup — tmux の git popup を担う Go TUI。git log 一覧 (行頭に CI job の成否マークを
# 非同期表示・未 push は橙 SHA) + 詳細 (diff + CI job → ブラウザ) + push。
# かつての changes/staging 画面と C-l トグルはユーザー判断 (2026-07-19) で撤去し log 専用。
# Go 実装は ~/dotfiles/src/git-popup/。glog は read-only ツールとして別物 (本ツールは触らない)。
# tmux popup から起動するため再ビルドは --async (bin/glogx と同方式)。

set -u

source "${0:A:h}/lib/go_autobuild.zsh"
go_autobuild_exec --async "${0:A:h}/../src/git-popup" git-popup -- "$@"
