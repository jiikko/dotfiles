#!/usr/bin/env zsh
# glogx — glog (read-only) に push 機能 (C-b) を足した派生版。Go implementation at:
#   ~/dotfiles/src/glogx/
# This wrapper auto-builds the binary on first use and re-builds when the
# source is newer than the compiled artifact.

set -u

src_dir="${0:A:h}/../src/glogx"
bin="$src_dir/glogx"

needs_build=0
if [[ ! -x "$bin" ]]; then
  needs_build=1
else
  # Rebuild if any .go source is newer than the binary. サブパッケージ (usage/ 等) も
  # 含めて再帰的に走査する: トップレベル *.go だけだと usage/*.go の変更で再ビルドされず
  # 古いバイナリが残る (**/*.go は zsh 再帰 glob でトップレベルも含む。(N)=nullglob)。
  for f in "$src_dir"/**/*.go(N) "$src_dir"/go.mod "$src_dir"/go.sum; do
    [[ -e "$f" ]] || continue
    # *_test.go は go build の入力にならない (生成物は同一) ので再ビルドのトリガから除外し、
    # テスト編集ループ中の無駄なビルド待ちを避ける。**/*.go~*_test.go は zsh の * が / を
    # 跨がず usage/*_test.go を取りこぼすため、ループ内で弾く。
    [[ "$f" == *_test.go ]] && continue
    if [[ "$f" -nt "$bin" ]]; then
      needs_build=1
      break
    fi
  done
fi

if (( needs_build )); then
  # src/glogx/go.mod は go 1.26 を要求する。手元の go が古い場合、GOTOOLCHAIN=auto は
  # ここで toolchain (~90MB) を黙ってダウンロードするため、ビルドが数十秒〜数分になる。
  # これは tmux の display-popup 内 (C-g) で起きるので、無言だとフリーズに見える。
  # GOTOOLCHAIN=local だと DL せず「go.mod requires go >= 1.26.0」で失敗するため、
  # その場合の対処 (toolchain を入れる) が読めるよう go 側のエラーをそのまま出す。
  local_go=$(go env GOVERSION 2>/dev/null || echo unknown)
  required_go=$(awk '$1 == "go" {print $2; exit}' "$src_dir/go.mod" 2>/dev/null)
  echo "glogx: building... (go=$local_go / go.mod=$required_go)" >&2
  if [[ -n "$required_go" && "${local_go#go}" != "$required_go"* ]]; then
    echo "glogx: 初回は Go $required_go の toolchain 取得で時間がかかることがあります" >&2
  fi
  (cd "$src_dir" && go build -o glogx .) || {
    echo "glogx: build failed" >&2
    exit 1
  }
fi

exec "$bin" "$@"
