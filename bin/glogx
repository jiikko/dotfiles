#!/usr/bin/env zsh
# glogx — glog (read-only) に push 機能 (C-b) を足した派生版。Go implementation at:
#   ~/dotfiles/src/glogx/
# tmux popup (C-g) から起動するため再ビルドは --async: 旧版で即起動し、新版は次回起動から
# 反映する (ビルド待ちを popup 内に見せない)。今すぐ新版が欲しいときは
# GO_AUTOBUILD_SYNC=1 glogx。機構は bin/lib/go_autobuild.zsh。

set -u

source "${0:A:h}/lib/go_autobuild.zsh"
go_autobuild_exec --async "${0:A:h}/../src/glogx" glogx -- "$@"
