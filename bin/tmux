#!/usr/bin/env bash
#
# bin/tmux — tmux ラッパー shim。本番 tmux サーバ (default) を **非対話シェルから
# kill-server / kill-session で殺せない**ようにする。それ以外は素の tmux へ素通しする。
#
# ─── なぜ (実害の記録) ───────────────────────────────────────────────────────────
# 2026-07-30 と 2026-09-11 に、Claude 起因で本番 tmux サーバ (default, 29〜30 セッション) が
# 2 度 kill された。2 度目は **テストスクリプト内部**の `tmux -L default kill-server` で、
# コマンド文字列に `tmux` も `kill-server` も現れなかったため、文字列を見る PreToolUse hook
# (_claude/hooks/deny-bare-tmux-kill.sh) では原理的に捕まえられなかった。
# 経路: 存在しない TMPDIR → mktemp -d 失敗 → guard_dir="" → TMUX_TMPDIR="" → tmux は空/不在の
# TMUX_TMPDIR を /tmp へフォールバックする (実測) → 本番へ kill-server。
# この shim は PATH 先頭 (~/dotfiles/bin は /opt/homebrew/bin より前) に居るので、
# **スクリプト内部の bare `tmux` 呼び出しも含めて**傍受できる唯一の層。
#
# ─── 脅威モデル ─────────────────────────────────────────────────────────────────
# 止めるのは「エージェント / 非対話スクリプトが**うっかり**本番サーバを kill する」形。
# 保護対象への操作を kind で分ける:
#   - **kill-server (サーバごと全滅)**: TTY の有無に関わらず**無条件で拒否**する。
#     エスケープは「実体を絶対パスで呼ぶ」1 本だけ (`/opt/homebrew/bin/tmux kill-server`)。
#     🚨 対話 TTY を通さない理由 = TTY gate は pty がチェーンに入ると非対話でも開くため
#     (script/expect/pty driver/tmux ペイン内。この repo は対話テストで pty driver 必須)。
#     catastrophic な操作にはこの穴を負えないので、エスケープを絶対パス 1 本に絞った。
#   - **kill-session (個別セッションの片付け = 日常操作)**: 対話 TTY のとき許可、非対話なら拒否。
#     Claude の Bash ツールは TTY を持たない (実測 2026-09-11: [ -t 0/1/2 ] すべて非ゼロ)。
# **意図的な回避は脅威に含めない** (対人の防御ではない)。以下は意図的に**検出しない**:
#   - 実体を絶対パスで直接呼ぶ形 (これが正規のエスケープ。grep 可能・記憶しやすい)。
#   - `send-keys` / `run-shell` / `if-shell` の中に書いた kill 文字列 (別レイヤーで実行される)。
#   - `{ }` コマンドグループ / `command-alias` / `tmux -c <shell-command>` の中の kill
#     (故意の tmux メタ構文。-c の値は want=discard で読み飛ばす。別レイヤーが実行する族)。
# 補助として _claude/hooks/deny-bare-tmux-kill.sh が `-L default` 直叩きを deny するが、
# それは**直接打たれたコマンド**にしか効かない (script 内部は上記のとおり届かない)。
#
# ─── 保護対象の定義 ─────────────────────────────────────────────────────────────
#   1. default socket の正規パス ($TMUX_TMPDIR 解決 + /tmp フォールバック後、dir を pwd -P で
#      正規化して basename=default を付けたもの。macOS では /tmp→/private/tmp)。
#   2. ~/.config/tmux-protected-sockets の各行 (正規化済み socket パス。ユーザーが名前付き
#      サーバを守りたいとき、または decoy テスト用に足す)。
# $TMUX の socket を「保護対象」に足さない (入れ子の隔離サーバの中で本番扱いになる誤爆を招く)。
# ただし target の**解決**には $TMUX を使う (bare kill が何を叩くか再現するため)。
#
# ─── 失敗時の向き (fail-closed) ─────────────────────────────────────────────────
# kill の target socket が確定できないときは **exec せず block** する。
# 「判定不能だから通す」は今回の事故の再生産なので選ばない。
set -uo pipefail

# ── 実体 tmux は絶対パスで固定する (PATH 探索は自分自身に解決して無限再帰する) ──
# 🚨 command -v / PATH 探索を使わない。~/dotfiles/bin は PATH 先頭なので自分に当たる
# (path-shim-must-resolve-real-binary.md)。Homebrew の symlink は版更新をまたいで安定。
REAL=/opt/homebrew/bin/tmux
# 自己参照の検出 (REAL がこの shim の配下を指したら即失敗。無限再帰は無音で回り続ける)。
case "$REAL" in
  */dotfiles/bin/tmux) printf 'tmux shim: REAL が自分自身を指している (%s)。中止。\n' "$REAL" >&2; exit 70 ;;
esac
[ -x "$REAL" ] || { printf 'tmux shim: 実体 tmux が見つからない/実行不可: %s\n' "$REAL" >&2; exit 127; }

# ── fast path: kill 系トークンを含まない呼び出しは、解析も fork も一切せず即 exec ──
# 🚨 ~/dotfiles/bin はユーザーの対話 PATH にも居て、precmd / statusline が tmux を高頻度に
# 叩く。この行より前でサブシェルを 1 つも起こさないこと (計測は tests 側で pin)。
# tmux は subcommand を前方一致で受けるので kill-server/kill-session は必ず "kill-s" を含む。
case " $* " in
  *' kill-s'*|*'kill-s'*) ;;   # kill かもしれない → 慎重な経路へ
  *) exec "$REAL" "$@" ;;
esac

# ── ここから kill の可能性がある経路 (fork 可) ──────────────────────────────────
uid=$(id -u)

# tmux のグローバルオプションを 1 パスで歩いて (a) subcommand が kill-server/kill-session か
# (b) -L <name> / -S <path> で socket が明示されているかを取る。
# 値を取るグローバルオプション (-L -S -f -c -T) は値を 1 トークン読み飛ばす (want で次を待つ)。
KILL_RE='^kill-s(er(v(er?)?)?|es(s(i(on?)?)?)?)$'
# 🚨 tmux は `;` / `\;` で複数コマンドを 1 呼び出しに連ねて**順に実行**する。最初の subcommand
# だけを見ると `list-sessions \; kill-server` のように**後続の kill を見落として本番へ通す**
# (敵対レビューが実測。最初が非 kill なら TTY すら不要で、2026-09-11 と同じ script 内部クラス)。
# → 連鎖の**全 subcommand**を走査する。global socket option (-L/-S/-f/-c/-T) は最初の subcommand
# より前にしか現れないので、そこだけで拾う。連鎖のどこかに kill があれば is_kill=1、
# その中で最厳の kind (server > session) を採る。
# 🚨 tmux の区切り規則 (decoy で実測した真値表):
#   **末尾が `;` の argv 要素は「1 個だけ」`;` を剥がして区切りにする。内部空白は無関係。**
#   残り (剥がした後) は**再トークン化されず**、直前のコマンドに付く (コマンド位置ならコマンド名)。
#   - `kill-server;`   → 剥がして `kill-server` = kill 実行 (DEAD)
#   - `display -p 'a ;' kill-server` → `'a ;'` が区切りになり後続の `kill-server` が実行 (DEAD)
#   - `kill-server ;`  → 剥がすと `kill-server ` = 未知コマンド (ALIVE。良性)
#   - `kill-server;;`  → 1 個だけ剥がすと `kill-server;` = 未知コマンド (ALIVE。良性)
#   - `a;kill-server`  → 末尾が `;` でない = 区切りでない (ALIVE。良性)
# KILL_RE は `$` 終端なので、良性形 (`kill-server ` / `kill-server;` / `a;kill-server`) は
# 剥がした後もマッチせず自然に PASS する。**だから内部空白でスキップしてはいけない** — スキップ
# すると `<非kill> '<arg> ;' kill-server` の区切りが立たず、後続 kill を arg 扱いで見逃す
# (round-4 が実際にこの穴を作り、最終ゲートが decoy で catastrophic を実証した)。
# → 末尾 `;` を **1 個だけ**剥がして区切りに立てる。空白の有無で分岐しない。
# 🚨 **exec は必ず原引数 "$@" で行う** (正規化トークンは検出専用。tmux へは渡さない)。
norm=()
for tok in "$@"; do
  case "$tok" in
    *";") base="${tok%;}"; [ -n "$base" ] && norm+=("$base"); norm+=(";") ;;   # 末尾 ; を 1 個剥がす
    *) norm+=("$tok") ;;
  esac
done

opt_L="" opt_S="" want="" seen_first_sub=0 expect_sub=1
is_kill=0 kind="" cur_sub=""                  # kind: "" なし / session / server (server が最厳)
for tok in ${norm[@]+"${norm[@]}"}; do        # 🚨 正規化トークンで走査 (exec は原引数)
  if [ -n "$want" ]; then                     # 直前の global option の値トークン
    case "$want" in L) opt_L="$tok" ;; S) opt_S="$tok" ;; esac  # discard は捨てる
    want=""; continue
  fi
  if [ "$tok" = ";" ]; then expect_sub=1; cur_sub=""; continue; fi   # 次の subcommand へ
  if [ "$expect_sub" = 1 ]; then
    # subcommand の位置。最初の subcommand より前だけ global socket option を拾う。
    case "$tok" in
      -L) [ "$seen_first_sub" = 0 ] && want=L; continue ;;
      -S) [ "$seen_first_sub" = 0 ] && want=S; continue ;;
      -L*) [ "$seen_first_sub" = 0 ] && opt_L="${tok#-L}"; continue ;;
      -S*) [ "$seen_first_sub" = 0 ] && opt_S="${tok#-S}"; continue ;;
      -f|-c|-T) [ "$seen_first_sub" = 0 ] && want=discard; continue ;;
      -*) continue ;;                         # その他のフラグ
    esac
    # 非オプション = subcommand 本体
    expect_sub=0; seen_first_sub=1; cur_sub="$tok"
    if [[ "$tok" =~ $KILL_RE ]]; then
      is_kill=1
      # kill-ser* = サーバごと全滅 / kill-ses* = 個別。曖昧形 (KILL_RE の最小は kill-ser/kill-ses)
      # は position 7 で解けるので誤らない。既に server を見ていれば下げない。
      case "$tok" in kill-ses*) [ "$kind" = server ] || kind=session ;; *) kind=server ;; esac
    fi
    continue
  fi
  # subcommand の引数。kill-session -a (指定 1 個以外を全滅 = catastrophic) を server へ昇格。
  if [ "$is_kill" = 1 ] && [ "$kind" = session ]; then
    case "$cur_sub" in
      kill-ses*)
        case "$tok" in
          -t*) : ;;                           # -t/-target のクラスタ (値)。-a ではない
          -*a*) kind=server ;;                # -a を含む短フラグクラスタ = 全滅系
        esac ;;
    esac
  fi
done

# kill でないなら (kill-s を含むが subcommand は別、等) 素通し。
[ "$is_kill" = 1 ] || exec "$REAL" "$@"

# ── target socket を tmux と同じ規則で解決する ─────────────────────────────────
# TMUX_TMPDIR: set かつ非空かつ dir が実在 → それ。さもなくば /tmp (実測した tmux の挙動)。
resolve_tmpdir() {
  if [ -n "${TMUX_TMPDIR:-}" ] && [ -d "${TMUX_TMPDIR:-/nonexistent}" ]; then
    printf '%s' "$TMUX_TMPDIR"
  else
    printf '%s' /tmp
  fi
}
# dir を pwd -P で正規化し basename を付ける (存在しない socket 実体を realpath しない。
# macOS の realpath は非存在パスで失敗する。dir は存在するので確実に正規化できる)。
canon_socket() { # canon_socket <socketパス> → 正規化パス (dir が無ければ元のまま)
  local p="$1" d b cd
  d=$(dirname -- "$p"); b=$(basename -- "$p")
  if cd=$(cd -- "$d" 2>/dev/null && pwd -P); then printf '%s/%s' "$cd" "$b"; else printf '%s' "$p"; fi
}

target=""
if [ -n "$opt_S" ]; then
  target="$opt_S"
elif [ -n "$opt_L" ]; then
  target="$(resolve_tmpdir)/tmux-$uid/$opt_L"
elif [ -n "${TMUX:-}" ]; then
  target="${TMUX%%,*}"                        # $TMUX の先頭フィールド = socket パス
else
  target="$(resolve_tmpdir)/tmux-$uid/default"
fi

# fail-closed: target が空 = 解決できなかった → block。
if [ -z "$target" ]; then
  printf 'tmux shim: kill の対象 socket を特定できなかったため中止 (fail-closed)。意図的なら実体を絶対パスで: %s\n' "$REAL" >&2
  exit 3
fi
target_canon=$(canon_socket "$target")
# 🚨 macOS の FS は case-insensitive (default と DEFAULT は同一ファイル = 同一サーバ。実測)。
# canon_socket は dir を pwd -P で畳むが basename の大小は畳まれないので、比較を小文字化して行う。
# これを怠ると `-L DEFAULT` / `-S <...>/DEFAULT` が本番に届くのに素通す (P1: 敵対レビューが
# end-to-end で実測。2026-09-11 に綴り 1 文字で 2 度事故を起こした的と同型)。
lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
target_lc=$(lc "$target_canon")

# ── 保護対象集合を組む ─────────────────────────────────────────────────────────
protected=""
# 1. default socket (TMUX_TMPDIR と /tmp フォールバックの両方を正規化して入れる)
add_protected() { protected+="$1"$'\n'; }
add_protected "$(canon_socket "$(resolve_tmpdir)/tmux-$uid/default")"
add_protected "$(canon_socket "/tmp/tmux-$uid/default")"
# 2. protect ファイルの各行
PROTECT_FILE="${TMUX_PROTECT_FILE:-$HOME/.config/tmux-protected-sockets}"
if [ -r "$PROTECT_FILE" ]; then
  while IFS= read -r line; do
    line="${line%%#*}"; line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] && add_protected "$(canon_socket "$line")"
  done < "$PROTECT_FILE"
fi

is_protected=0
while IFS= read -r p; do
  [ -n "$p" ] || continue
  [ "$(lc "$p")" = "$target_lc" ] && { is_protected=1; break; }   # 🚨 case-insensitive で照合
done <<PROT
$protected
PROT

# 保護対象でなければ素通し (隔離テストサーバ tt-cleanup-* / ctrlv-test-* 等はここを通る)。
[ "$is_protected" = 1 ] || exec "$REAL" "$@"

# ── 保護対象への kill ──────────────────────────────────────────────────────────
# kill-session (個別セッションの片付け = 日常操作) は対話 TTY のとき許可する。
# kill-server (サーバごと全滅 = 2026-07-30/09-11 の catastrophic 形) は **TTY でも無条件で拒否**する。
# 🚨 TTY gate は pty がチェーンに入ると非対話でも開く (P2: script/expect/pty driver/tmux ペイン内。
# この repo は対話テストで pty driver を必須にしている)。最悪形 (kill-server) はその穴を負えないので、
# エスケープを「実体を絶対パスで呼ぶ」1 本に絞る。
if [ "$kind" = session ] && { [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; }; then
  exec "$REAL" "$@"                           # 対話ユーザーのセッション整理は通す
fi

if [ "$kind" = server ]; then
  printf 'tmux shim: 🚨 本番 tmux サーバ (%s) の kill-server を拒否しました。\n' "$target_canon" >&2
  printf '  サーバごと全滅させる操作は、対話シェルでも通しません (2026-07-30 / 2026-09-11 の誤殺防止)。\n' >&2
  printf '  本当に消すなら実体を絶対パスで: %s kill-server\n' "$REAL" >&2
else
  printf 'tmux shim: 🚨 本番 tmux サーバ (%s) への kill-session を非対話シェルから拒否しました。\n' "$target_canon" >&2
  printf '  対話シェルで実行するか、実体を絶対パスで: %s\n' "$REAL" >&2
fi
exit 4
