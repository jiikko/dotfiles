#!/usr/bin/env bash
# ja-textlint — 日本語の文章を textlint (preset-ja-technical-writing) で検査し、続けて同じ文に `ja-writing lint` を掛ける (skill ja-writing の機械の検査)。
#
# usage:
#   ja-textlint <file>...                  # Markdown / テキストのファイルを検査する
#   ja-textlint --stdin --stdin-filename x.md < text   # 標準入力の文を検査する (コミットメッセージ・UI の文言の下書き)
#   (残りの引数は textlint にそのまま渡る。--fix も効く)
#
# バージョンと規則の正本: _claude/skills/ja-writing/textlint/ (package.json・package-lock.json・textlintrc.json と、自作の規則の rules/)。
# 依存は ${XDG_CACHE_HOME:-~/.cache}/ja-textlint/<lock の hash>/ に npm ci で入れる。dotfiles の作業ツリーに node_modules を作らない
# (worktree ごとに入れ直さずに済み、gitignore の漏れで巨大な差分が出ることもない)。lock が変わると hash が変わり、入れ直す。
#
# ja-writing lint (src/ja-writing。bin/ja-writing が初回と入力の変化のたびに go build する):
#   textlint の出力の後に、ファイルごとに「ja-writing lint: <名前>」の行と ja-writing lint の出力を標準出力へ足す。
#   ファイルは標準入力で渡す (ja-writing lint は作業フォルダの外と点で始まる名前のファイルを断る。ja-textlint はどこのファイルにも掛ける)。
#   掛けるのは textlint が読むものだけ (.textlintignore・--ignore-path に載ったもの・対象でない拡張子・名前と別のファイルに当たる glob には掛けない。
#   標準入力が空でなければ、textlint と同じくファイルは読まず、--stdin-filename の拡張子が対象のときだけ標準入力に掛ける)。
#   引数はこのスクリプトで読まず、textlint と同じ関数で読む bin/lib/ja_textlint_targets.cjs に任せる (`-f=json`・`--` の後ろの名前なども textlint と同じに読む)。
#   補助が失敗したら textlint だけ掛けて rc 3 以上。textlint の依存が無いときは、オプションの無い形 (ファイルだけ) のときだけ拡張子で選んで掛ける。
#   `--fail-on error` を付けて起こすので、warn と info だけなら rc 0 (textlint の warning と同じ扱い)。
#   textlint の出力だけを返し ja-writing lint を掛けない形 (標準エラーに 1 行出す): --fix / --dry-run・-f / --format が stylish 以外・-o・textlint が引数を読めないとき。
#     --fix は ja-writing lint が直さないので、直した後にもう一度打つ。整形の指定は機械が読む出力で、別の形の文を混ぜると読めなくなる
#     (_claude/hooks/ja-textlint-on-edit.sh は -f json を jq で読む)。
#   -h・-v・--init・--print-config・--mcp は textlint だけで、何も足さない。
#   JA_TEXTLINT_NO_INSTALL を付けると、ビルド済みで入力と合うバイナリだけを使い (go_autobuild_exec --no-build)、無ければ掛けずに rc 3。
#   語の一覧: 検査するファイルの置かれた repo が自分の .yomiyasu-words/ を持つならそれを使い、
#   無ければ dotfiles で定義した用語の一覧 (_claude/skills/ja-writing/words/) を --words で渡す (どの repo のファイルでも、定義した用語を指摘しない)。
#   探す場所はファイルと標準入力で違う。ファイルは、そのファイルのフォルダで ja-writing lint を起こす (起動した cwd は見ない。
#   ja-writing lint がそのフォルダの git の最上位かそのフォルダで見つける。_claude/hooks/ja-textlint-on-edit.sh と同じ)。
#   標準入力の文は置き場所が無いので、起動した cwd から探す (cwd の repo の一覧が当たる)。
#
# 見ないもの: 主語・目的語の抜け、語が機能を言い表しているか、直訳の硬さ (構文として整った文は素通りする)。
# そこは skill ja-writing の手順 (人と Claude が読んで直す) が受け持つ。
#
# 終了コード: textlint の rc と ja-writing lint の rc の大きい方。
#   textlint: 0 = 指摘なし / 1 = 指摘あり / 2 = 設定や引数の誤り / 3 = 依存を入れられない・JA_TEXTLINT_NO_INSTALL で依存が無い。
#   ja-writing lint: 0 = error の候補なし / 1 = error の候補あり / 2 = 入力の誤り (UTF-8 で読めない等) / 3 = ビルドできない・ビルドが無い (掛けられない)。
#   片方が 2 / 3 で終わっても、もう片方は走らせて指摘を出す。
set -euo pipefail

self="$(readlink -f "$0")"
root="$(dirname "$(dirname "$self")")"
src="$root/_claude/skills/ja-writing/textlint"

# textlint の依存を確かめ、無ければ入れる。入れられなければ rc 3 を返す (呼び出し元が ja-writing lint を続けるかを決める)
ensure_textlint() {
  for f in package.json package-lock.json textlintrc.json; do
    [ -f "$src/$f" ] || { echo "ja-textlint: $src/$f が無い" >&2; return 3; }
  done
  [ -d "$src/rules" ] || { echo "ja-textlint: $src/rules が無い" >&2; return 3; }

  hash="$(shasum -a 256 "$src/package-lock.json" | cut -c1-16)"
  base="${XDG_CACHE_HOME:-$HOME/.cache}/ja-textlint"
  cache="$base/$hash"
  bin="$cache/node_modules/.bin/textlint"

  if [ ! -x "$bin" ]; then
    # 入っていなければ入れずに止める (hook のように、編集のたびに npm を走らせたくない呼び出し元が付ける)
    [ -z "${JA_TEXTLINT_NO_INSTALL:-}" ] || { echo "ja-textlint: textlint が入っていない (JA_TEXTLINT_NO_INSTALL なので入れない)" >&2; return 3; }
    command -v npm >/dev/null || { echo "ja-textlint: npm が無い (node を入れる)" >&2; return 3; }
    mkdir -p "$base"
    # 入れ終えてから名前を変えて公開する。途中で止まった入れかけを、次の起動が「入っている」と読まない
    staging="$(mktemp -d "$base/.staging.XXXXXX")"
    cp "$src/package.json" "$src/package-lock.json" "$staging/"
    echo "ja-textlint: textlint を入れる ($cache)" >&2
    if ! (cd "$staging" && npm ci --ignore-scripts --no-audit --no-fund --loglevel=error >&2); then
      rm -rf "$staging"
      echo "ja-textlint: npm ci に失敗した" >&2
      return 3
    fi
    # 並行して入れた別の起動が先に公開していたら、こちらは捨てる。`mv` に任せない: 公開先のディレクトリが在ると失敗せず、
    # その中へ入れ子で移す。有無を見てから移すまでの間に別の起動が公開すると入れ子が 1 つ残るが、使う側 ($bin) は壊れない
    if [ -d "$cache" ]; then
      rm -rf "$staging"
    else
      mv "$staging" "$cache"
    fi
  fi

  return 0
}

textlint_args=(--config "$src/textlintrc.json" --rulesdir "$src/rules")

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

trc=0
have_textlint=0
if ensure_textlint; then have_textlint=1; else trc=$?; fi

# ja-writing lint をどこに掛けるかを決める。引数はここで読まず、textlint と同じ関数で読む補助に任せる (bin/lib/ja_textlint_targets.cjs。欄の意味は冒頭)
mode=lint
reads_stdin=0
stdin_name=""
stdin_skip=""
kinds=()
vals=()
plan_ok=0
if [ "$have_textlint" -eq 1 ]; then
  if node "$root/bin/lib/ja_textlint_targets.cjs" "$cache/node_modules" -- "${textlint_args[@]}" "$@" >"$work/plan" 2>"$work/plan.err"; then
    plan=()
    while IFS= read -r -d '' x; do plan+=("$x"); done <"$work/plan"
    if [ "${#plan[@]}" -ge 5 ]; then
      plan_ok=1
      mode="${plan[0]}"; reason="${plan[1]}"; reads_stdin="${plan[2]}"; stdin_name="${plan[3]}"; stdin_skip="${plan[4]}"
      k=5
      while [ "$k" -lt "${#plan[@]}" ]; do kinds+=("${plan[$k]}"); vals+=("${plan[$((k + 1))]:-}"); k=$((k + 2)); done
    fi
  fi
  cat "$work/plan.err" >&2
  if [ "$plan_ok" -eq 0 ]; then
    # 対象を決められないまま ja-writing lint を掛けると、textlint が読まないものに掛けて rc を変える。textlint だけ掛けて rc 3 以上にする
    echo "ja-textlint: textlint の対象を判定できないので ja-writing lint は掛けない (理由は上の行)" >&2
    "$bin" "${textlint_args[@]}" "$@" || trc=$?
    [ "$trc" -ge 3 ] && exit "$trc"
    exit 3
  fi
  case "$mode" in
    quiet) exec "$bin" "${textlint_args[@]}" "$@" ;;
    only)
      echo "ja-textlint: ${reason}は textlint だけを掛け、ja-writing lint は掛けない" >&2
      exec "$bin" "${textlint_args[@]}" "$@" ;;
  esac
  stdin_file=""
  if [ "$reads_stdin" = 1 ]; then
    # 標準入力は 1 度しか読めないので、textlint と ja-writing lint の両方へ渡すためにいったんファイルに受ける
    stdin_file="$work/stdin"
    cat >"$stdin_file"
    "$bin" "${textlint_args[@]}" "$@" <"$stdin_file" || trc=$?
  else
    "$bin" "${textlint_args[@]}" "$@" || trc=$?
  fi
  # textlint は標準入力が空でなければファイルを読まない (lib/src/cli.js の execute)
  if [ -n "$stdin_file" ] && [ -s "$stdin_file" ]; then
    if [ "${#kinds[@]}" -gt 0 ]; then
      echo "ja-textlint: 標準入力を読むので、引数のファイル ${#kinds[@]} 件には textlint も ja-writing lint も掛けない" >&2
    fi
    if [ -n "$stdin_name" ]; then
      kinds=(I); vals=("$stdin_name")
    else
      kinds=(); vals=()
      echo "ja-textlint: ${stdin_skip}ので、標準入力に ja-writing lint は掛けない" >&2
    fi
  fi
else
  # textlint の依存が無いので引数を textlint と同じには読めない。rc は 3 に決まっているので、オプションの無い形 (ファイルだけ) のときだけ、
  # textlint の既定の plugin (text と markdown) の拡張子で選んで指摘は出す。.textlintignore は見ない
  for a in "$@"; do
    case "$a" in
      -*) echo "ja-textlint: textlint が無いので引数を読めず、ja-writing lint は掛けない ($a)" >&2; exit "$trc" ;;
    esac
  done
  echo "ja-textlint: textlint が無いので .textlintignore を見ずに拡張子だけで ja-writing lint の対象を選ぶ" >&2
  for f in "$@"; do
    if [ ! -f "$f" ]; then
      kinds+=(S); vals+=("$f はファイルでない")
    else
      case "$f" in
        *.md|*.markdown|*.mdown|*.mkdn|*.mkd|*.mdwn|*.mkdown|*.ron|*.txt) kinds+=(T); vals+=("$f") ;;
        *) kinds+=(S); vals+=("$f は textlint の対象の拡張子でない") ;;
      esac
    fi
  done
fi

# ja-writing を起こす。JA_TEXTLINT_NO_INSTALL ならビルドせず (go_autobuild_exec --no-build)、無ければ bin/ja-writing が同期でビルドする。
# 先に --version で起こせるかを確かめる。lint の rc 1 (error の候補) とビルドの失敗 (go_autobuild_exec の rc 1) は rc では分けられないので、
# lint の後も、検査の見出しの行が標準出力に出たかで「走った」を見分ける。
# 確かめと lint で起こし方を揃える: 同期のビルドの直後に --no-build で起こすと「バイナリが古い」で rc 2 になることがある (実測 2026-11-20、新しい worktree の初回)
jw() {
  if [ -n "${JA_TEXTLINT_NO_INSTALL:-}" ]; then
    zsh -c 'source "$1"; shift; go_autobuild_exec --no-build "$1" ja-writing -- "${@:2}"' _ "$root/bin/lib/go_autobuild.zsh" "$root/src/ja-writing" "$@"
  else
    "$root/bin/ja-writing" "$@"
  fi
}
# <フォルダ> を cwd にして jw を起こす (空なら起動した cwd のまま)。ja-writing lint は語の一覧を cwd から探す。
# 🚨 入力のリダイレクトは呼び出しの側 (cd の前) に書く。この中で開くと、相対パスの名前を cd した先で開いて読めない
jw_in() { # <フォルダ> <ja-writing の引数>...
  local d="$1"
  shift
  if [ -n "$d" ]; then
    # -P: symlink を辿った先 (物理のパス) で .. を解く。textlint と ja-writing はファイルを物理のパスで読むので、論理の cd だと
    # `link/../x.md` で読むファイルと一覧を探すフォルダが別になる
    (cd -P -- "$d" && jw "$@")
  else
    jw "$@"
  fi
}
# ファイルのフォルダを絶対パスで返す (REPLY)。相対のまま cd に渡すと CDPATH で別のフォルダに入る。
# dirname のコマンド置換で取らない: 置換は末尾の改行を落とすので、改行で終わる名前のフォルダが別のフォルダの名前になる
dir_of() { # <ファイルの名前>
  case "$1" in
    */*) REPLY="${1%/*}"; [ -n "$REPLY" ] || REPLY=/ ;;
    *) REPLY=. ;;
  esac
  case "$REPLY" in /*) ;; *) REPLY="$PWD/$REPLY" ;; esac
}
# <フォルダ> (空なら起動した cwd) で起こす ja-writing lint に渡す --words を words に入れる。答えはフォルダごとに違うので、フォルダごとに 1 回確かめる。
# 一覧の探し方を写さない: 見つけたかは ja-writing lint の --json の context.words で見る (一覧を使ったときだけ出る)
# 確かめが失敗したら (repo の一覧が読めない等) 差し替えない。差し替えると壊れた一覧が気づかれないまま別の一覧で通る。
# そのまま lint に進み、ja-writing lint 自身が誤り (rc 2) を出す
probed_dirs=()
probed_need=()
words_for() { # <フォルダ>
  local i need=0 probe=0
  words=()
  for i in ${probed_dirs[@]+"${!probed_dirs[@]}"}; do
    if [ "${probed_dirs[$i]}" = "$1" ]; then
      [ "${probed_need[$i]}" -eq 0 ] || words=(--words "$root/_claude/skills/ja-writing/words")
      return 0
    fi
  done
  jw_in "$1" lint --json - </dev/null >"$work/words.json" 2>/dev/null || probe=$?
  if [ "$probe" -eq 0 ] && ! grep -qF '"words": {' "$work/words.json"; then
    need=1
    words=(--words "$root/_claude/skills/ja-writing/words")
  fi
  probed_dirs+=("$1")
  probed_need+=("$need")
}
lint_one() { # <表示の名前> <中身のファイル> <起こすフォルダ (空なら起動した cwd)>
  local r=0
  printf '\nja-writing lint: %s\n' "$1"
  words_for "$3"
  jw_in "$3" lint --fail-on error ${words[@]+"${words[@]}"} - <"$2" >"$work/jw.out" || r=$?
  cat "$work/jw.out"
  # rc 1 で見出しが無いのはビルドの失敗 (go_autobuild_exec)。rc 2 は入力の誤り (UTF-8 で読めない等) のまま 2 にする
  if [ "$r" -eq 1 ] && ! grep -qF '表現・書式の検査を実行しました' "$work/jw.out"; then
    echo "ja-textlint: ja-writing lint が検査の前に終わった (rc=$r)" >&2
    r=3
  fi
  case "$r" in 0|1|3) ;; *) r=2 ;; esac
  [ "$r" -le "$wrc" ] || wrc=$r
}

wrc=0
skipped=0
lint=0
for k in ${kinds[@]+"${!kinds[@]}"}; do
  if [ "${kinds[$k]}" = S ]; then
    echo "ja-textlint: ${vals[$k]}ので ja-writing lint は掛けない" >&2
    skipped=$((skipped + 1))
  else
    lint=$((lint + 1))
  fi
done
if [ "$lint" -gt 0 ]; then
  if [ -n "${JA_TEXTLINT_NO_INSTALL:-}" ]; then
    jw lint --version >/dev/null 2>&1 || wrc=3
    [ "$wrc" -eq 0 ] || echo "ja-textlint: ja-writing lint を掛けられない (ビルドが無いか古い。JA_TEXTLINT_NO_INSTALL なのでビルドしない。bin/ja-writing を打つとビルドする。初めてのビルドの後はもう 1 回作り直すので 2 回打つ)" >&2
  else
    jw lint --version >/dev/null || wrc=3
    [ "$wrc" -eq 0 ] || echo "ja-textlint: ja-writing lint を掛けられない (bin/ja-writing のビルドに失敗した。理由は上の行)" >&2
  fi
  if [ "$wrc" -eq 0 ]; then
    for k in "${!kinds[@]}"; do
      case "${kinds[$k]}" in
        T) dir_of "${vals[$k]}"; lint_one "${vals[$k]}" "${vals[$k]}" "$REPLY" ;;
        I) lint_one "${vals[$k]}" "$stdin_file" "" ;;
      esac
    done
  fi
fi
[ "$skipped" -eq 0 ] || echo "ja-textlint: ja-writing lint を掛けなかったファイル: ${skipped} 件" >&2

[ "$trc" -ge "$wrc" ] && exit "$trc"
exit "$wrc"
