#!/usr/bin/env bash
# ja-textlint — 日本語の文章を textlint (preset-ja-technical-writing) で検査する (skill ja-writing の機械の検査)。
#
# usage:
#   ja-textlint <file>...                  # Markdown / テキストのファイルを検査する
#   ja-textlint --stdin --stdin-filename x.md < text   # 標準入力の文を検査する (コミットメッセージ・UI の文言の下書き)
#   (残りの引数は textlint にそのまま渡る。--fix も効く)
#
# 版と規則の正本: _claude/skills/ja-writing/textlint/ (package.json・package-lock.json・textlintrc.json)。
# 依存は ${XDG_CACHE_HOME:-~/.cache}/ja-textlint/<lock の hash>/ に npm ci で入れる。dotfiles の作業ツリーに node_modules を作らない
# (worktree ごとに入れ直さずに済み、gitignore の漏れで巨大な差分が出ることもない)。lock が変わると hash が変わり、入れ直す。
#
# 見ないもの: 主語・目的語の抜け、語が機能を言い表しているか、直訳の硬さ (構文として整った文は素通りする)。
# そこは skill ja-writing の手順 (人と Claude が読んで直す) が受け持つ。
#
# 終了コード: textlint のまま (0 = 指摘なし / 1 = 指摘あり / 2 = 設定や引数の誤り)。依存を入れられないときは 3。
set -euo pipefail

self="$(readlink -f "$0")"
root="$(dirname "$(dirname "$self")")"
src="$root/_claude/skills/ja-writing/textlint"
for f in package.json package-lock.json textlintrc.json; do
  [ -f "$src/$f" ] || { echo "ja-textlint: $src/$f が無い" >&2; exit 3; }
done

hash="$(shasum -a 256 "$src/package-lock.json" | cut -c1-16)"
base="${XDG_CACHE_HOME:-$HOME/.cache}/ja-textlint"
cache="$base/$hash"
bin="$cache/node_modules/.bin/textlint"

if [ ! -x "$bin" ]; then
  command -v npm >/dev/null || { echo "ja-textlint: npm が無い (node を入れる)" >&2; exit 3; }
  mkdir -p "$base"
  # 入れ終えてから名前を変えて公開する。途中で止まった入れかけを、次の起動が「入っている」と読まない
  staging="$(mktemp -d "$base/.staging.XXXXXX")"
  cp "$src/package.json" "$src/package-lock.json" "$staging/"
  echo "ja-textlint: textlint を入れる ($cache)" >&2
  if ! (cd "$staging" && npm ci --ignore-scripts --no-audit --no-fund --loglevel=error >&2); then
    rm -rf "$staging"
    echo "ja-textlint: npm ci に失敗した" >&2
    exit 3
  fi
  # 並行して入れた別の起動が先に公開していたら、こちらは捨てる。`mv` に任せない: 公開先のディレクトリが在ると失敗せず、
  # その中へ入れ子で移す。有無を見てから移すまでの間に別の起動が公開すると入れ子が 1 つ残るが、使う側 ($bin) は壊れない
  if [ -d "$cache" ]; then
    rm -rf "$staging"
  else
    mv "$staging" "$cache"
  fi
fi

exec "$bin" --config "$src/textlintrc.json" "$@"
