#!/bin/bash
# tmux-toast — フォーカスを奪わない toast 通知を tmux の右下に表示する
#
# display-popup はモーダル (表示中のキー入力を必ず奪う) で非ブロック化は本家で却下済み
# (tmux/tmux PR #4379 → floating panes に置き換えられ close, 2026-05)。
# 代わりにその floating panes (`new-pane -X/-Y`, tmux 3.7 系に搭載) を -d 付きで使う。
# 通常の pane と同じ描画レイヤなのでフォーカスを奪わず、点滅もしない。
#
# floating panes が無い古い tmux では、クライアント tty へ直接エスケープシーケンスで
# 描画する fallback を使う (tmux の再描画に消されるため短周期で描き直す。点滅は残る)。
#
# 使い方: tmux-toast [-d 秒] [-f 前景色] [-b 背景色] [-e pane_id] メッセージ...
#   -e: この pane_id が「直近 8 個の toast 自身の pane」のどれかなら何も表示しない。
#       pane-exited hook から呼ぶときに #{hook_pane} を渡す (toast pane の終了で
#       閉じ通知が再帰的に出続けるのを防ぐ)
#   -F: ノイズ抑止ガード (2 秒デバウンス / agent panel の quiet 窓) を無視して必ず出す。
#       **hook から呼ぶときには使わない** (toast が toast を生む無限増殖の抑止がこれ)。
#       用途は「ユーザーの操作に対する直接の応答」で、間引かれると押した本人が
#       効いたかどうか分からなくなるもの (例: C-v のペースト通知。@tmux_toast_last_epoch の
#       記録自体は force でも行うので、この toast pane 生成が呼ぶ hook 側は従来どおり黙る)
set -euo pipefail
unset CDPATH  # export された CDPATH の下では、相対パスの cd が解決先を stdout に出し $(cd … && pwd) を壊す

duration=2
fg=15
bg=22   # 濃い緑
exclude_pane=''
force=0

usage() {
  echo "usage: tmux-toast [-d seconds] [-f fg-color] [-b bg-color] [-e pane-id] [-F] message..." >&2
  exit 2
}

while getopts 'd:f:b:e:Fh' opt; do
  case "$opt" in
    d) duration=$OPTARG ;;
    f) fg=$OPTARG ;;
    b) bg=$OPTARG ;;
    e) exclude_pane=$OPTARG ;;
    F) force=1 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage
msg="$*"

[ -n "${TMUX:-}" ] || { echo "tmux-toast: not inside tmux" >&2; exit 1; }

# toast 自身の pane 起因の呼び出しは無視する (-e に pane-exited の #{hook_pane} が来る)。
# 🚨 **直近 N 個を覚える**。1 個だけだと toast が同時に複数生きるとき古い方の終了が
# 除外を抜け、「🗑 pane を閉じました」の偽通知が出る (実測 2026-09-05: -F のペースト通知を
# 2 連発すると toast pane が 2 枚でき、1 枚目の pane-exited が第 3 の toast を生んだ)。
# -F で抑止を外した経路があるので、同時に生きる toast は 1 枚とは限らない
TOAST_PANE_MEMORY=8
recent_panes=$(tmux show-option -gqv @tmux_toast_pane)
if [ -n "$exclude_pane" ]; then
  case " $recent_panes " in
    *" $exclude_pane "*) exit 0 ;;
  esac
fi

# 再入ガード: toast 用の new-pane 自体が after-split-window hook を発火させる (実測,
# tmux 3.7b)。hook からこのスクリプトを呼ぶ構成だと toast が toast を生む無限ループに
# なるため、直近 2 秒以内に toast を出していたら黙って skip する。
# 副作用として 2 秒以内の連続通知は 1 つに間引かれる (通知 UI としては許容)
now=$(date +%s)
last=$(tmux show-option -gqv @tmux_toast_last_epoch)
if [ "$force" = 0 ] && [ -n "$last" ] && [ $((now - last)) -lt 2 ]; then
  exit 0
fi

# agent panel (scripts/tmux_agent_panel.sh) の kill/create 由来のイベントは通知しない。
# panel は window 切替のたびに pane を作り直すため、これが無いと切替ごとに
# 「分割/閉じました」toast が出る。panel が直前に @agent_panel_busy へ epoch を書く。
# 窓内 (3 秒) の実イベント toast も落ちるが装飾通知なので許容
AGENT_PANEL_QUIET_SECS=3
panel_busy=$(tmux show-option -gqv @agent_panel_busy)
if [ "$force" = 0 ]; then
  case "$panel_busy" in
    ''|*[!0-9]*) ;;
    *) [ $((now - panel_busy)) -lt "$AGENT_PANEL_QUIET_SECS" ] && exit 0 ;;
  esac
fi
tmux set-option -g @tmux_toast_last_epoch "$now"

# 表示セル幅。bash の ${#msg} は文字数でありセル幅ではない。幅は bin/termwidth (tuikit の termwidth.Of。Go) で測る。
# 測れない環境 (go が無い・ビルドの失敗・PATH を絞った呼び出しで zsh が無い) では「全文字 2 セル」の安全側上界で
# 代用する (box が広めに出るだけで壊れない。幅は後段で window/client 幅に clamp される)。非 0 で死なせないこと:
# hook の run-shell はエラーをアクティブ pane の view-mode として積む (下の fallback 冒頭コメント参照)。
# 自己位置は外部コマンド (dirname) を使わずに解く (下の floating の節と同じ理由)
# 🚨 ビルド済みのバイナリが無い (新しい checkout・成果物を消した直後) ときは待たない。ラッパーは初回だけ同期でビルドするので、
# 前景で呼ぶ scripts/tmux_paste_clipboard.sh の通知がビルドの間 (数秒〜) 止まる。上界で出し、ビルドは裏で起こして次から測る。
# TMUX_TOAST_TERMWIDTH_BIN はテストがバイナリの有無を差し替える口
_tw_wrapper="${BASH_SOURCE[0]%/*}/termwidth"
_tw_bin="${TMUX_TOAST_TERMWIDTH_BIN:-${BASH_SOURCE[0]%/*}/../src/tuikit/cmd/termwidth/termwidth}"
width=""
if [ -x "$_tw_bin" ]; then
  width=$("$_tw_wrapper" "$msg" 2>/dev/null) || width=""
else
  ( "$_tw_wrapper" x </dev/null >/dev/null 2>&1 & ) 2>/dev/null || true
fi
case "$width" in
  ''|*[!0123456789]*) width=$((${#msg} * 2)) ;;
esac

# --- 本命: floating pane (tmux 3.7+) ---------------------------------------
# new-pane の -X/-Y は floating panes 対応ビルドにのみ存在する
if grep -q -- '-X x-position' <<< "$(tmux list-commands new-pane 2>/dev/null)"; then
  # ジオメトリの決定は lib に寄せてある (clamp の罠の一次情報もそこ)。
  # 🚨 lib が読めない環境 (新品チェックアウト / lib を持たない worktree) でも**非 0 で
  # 死なないこと**: hook 経由の呼び出しが非 0 を返すとアクティブ pane に view-mode が積まれる
  # (docs/feedback-nvim-tmux-2026-07-29.md 節 1)。読めなければ通知を諦めて exit 0 する。
  # source を floating 経路の中に置くのは、下の tty 直描画 fallback を lib 不在でも生かすため。
  # 🚨 自己位置の解決に外部コマンド (dirname) を使わないこと。このスクリプトは PATH を
  # 絞った環境からも呼ばれ (tests/tmux/test_tmux_toast.sh の「幅を測れない」ケース)、
  # `set -e` 下ではコマンド置換の失敗がそのまま非 0 終了になる = hook 汚染に直結する。
  _geom_dir="$(cd "${BASH_SOURCE[0]%/*}/../scripts/lib" 2>/dev/null && pwd)" || _geom_dir=""
  [ -n "$_geom_dir" ] && [ -r "$_geom_dir/tmux_float_geometry.sh" ] || exit 0
  # shellcheck source=scripts/lib/tmux_float_geometry.sh
  . "$_geom_dir/tmux_float_geometry.sh" || exit 0
  read -r win_w win_h < <(tmux display-message -p '#{window_width} #{window_height}')
  tt_float_geom "$win_w" "$win_h" "$((width + 4))" 3 bottom-right || exit 0
  box_w=$TT_FLOAT_W; box_h=$TT_FLOAT_H; x=$TT_FLOAT_X; y=$TT_FLOAT_Y
  # shellcheck disable=SC2016 # sh -c の '$1'/'$2' は pane 内の sh が展開する (意図どおり)
  # 🚨 失敗を無音で飲むこと (`2>/dev/null || exit 0`)。set -euo pipefail のまま非 0 で抜けると、
  # hook (after-split-window / pane-exited) 経由の呼び出しでアクティブ pane に view-mode が
  # 積まれる (end-to-end で実測 2026-08-21。発火因子は終了コードで、stderr 単独では積まれない)。
  # 下の fallback 経路は「非 0 や stderr を返さないこと」と自ら明記しており、ここだけ非対称だった。
  pane_id=$(tmux new-pane -d -P -F '#{pane_id}' -x "$box_w" -y "$box_h" -X "$x" -Y "$y" \
    -s "fg=colour${fg},bg=colour${bg}" \
    -R "fg=colour${fg},bg=colour${bg}" \
    -- sh -c 'printf "\n  %s" "$1"; sleep "$2"' tmux-toast "$msg" "$duration" 2>/dev/null) || exit 0
  # -e 除外用に toast pane の id を記録 (この pane の pane-exited は通知しない)
  # 🚨 **追記は -a (append) で tmux 側にやらせる**。読んで書き戻す形は競合する:
  # 2 本同時に走ると両方が同じ値を読み、後勝ちで片方の id が消えて除外を抜ける
  # (実測 2026-09-05: -F のペースト 2 連発で @tmux_toast_pane が [%1] になり、%2 の
  # 終了が偽の閉じ通知を生んだ)
  tmux set-option -ag @tmux_toast_pane " $pane_id"
  # 上限で切り詰める (best-effort。ここは競合しても「多めに覚える」方向にしか壊れず、
  # pane id は単調増加で再利用されないので過剰保持は無害)
  # shellcheck disable=SC2046 # 空白区切りの語として数えたい (意図どおりの分割)
  set -- $(tmux show-option -gqv @tmux_toast_pane)
  if [ "$#" -gt "$TOAST_PANE_MEMORY" ]; then
    shift $(( $# - TOAST_PANE_MEMORY ))
    tmux set-option -g @tmux_toast_pane "$*"
  fi
  exit 0
fi

# --- fallback: クライアント tty へ直接描画 (floating panes 非対応 tmux) -----
# 表示先クライアントが無い (detached サーバ / headless テスト等) なら黙って exit 0 する。
# 🚨 ここで非 0 や stderr を返さないこと: after-split-window / pane-exited hook の
# run-shell はエラー出力をアクティブ pane の view-mode として積み、tmux 3.4 では
# モードスタックが copy-mode のスクロールを無反応にする実害がある (CI の
# test_smooth_scroll step5 が split 直後の C-u 無反応で fail した実測 2026-07-29)。
# 通知の表示先が無いのは異常ではなく「何も表示しない」が正しい縮退。
# client_tty は単独で読む (3 値まとめ読みだと空の tty がフィールド collapse で
# cols/rows にずれ、誤った値を tty として検査していた)
tty=$(tmux display-message -p '#{client_tty}')
[ -n "$tty" ] && [ -w "$tty" ] || exit 0
read -r cols rows < <(tmux display-message -p '#{client_width} #{client_height}')

box_w=$((width + 4))
[ "$box_w" -gt "$cols" ] && box_w=$cols
col=$((cols - box_w + 1))
[ "$col" -lt 1 ] && col=1
row=$((rows - 3))

pad=$(printf '%*s' $((box_w - 2 - width)) '')

# 1 回の write でまとめて描画する (途中で pane 出力と混ざるのを避ける)
# \e7/\e8 = カーソル保存/復元。SGR 48;5/38;5 = 256 色指定
draw() {
  {
    printf '\e7'
    printf '\e[%d;%dH\e[38;5;%dm\e[48;5;%dm%*s\e[0m' "$row"       "$col" "$fg" "$bg" "$box_w" ''
    printf '\e[%d;%dH\e[38;5;%dm\e[48;5;%dm  %s%s\e[0m' $((row+1)) "$col" "$fg" "$bg" "$msg" "$pad"
    printf '\e[%d;%dH\e[38;5;%dm\e[48;5;%dm%*s\e[0m' $((row+2))   "$col" "$fg" "$bg" "$box_w" ''
    printf '\e8'
  } > "$tty"
}

# tmux 側の再描画 (pane 分割・移動・出力等) に上書きされるため、1 回描いて終わりでは
# duration より遥かに早く消える。表示期間中は短周期で描き直して勝ち続け、
# 期間終了後に refresh-client で tmux に再描画させて消す。呼び出し元はブロックしない。
# tmux の再描画を止める手段は無いため「消される→描き直す」の点滅は原理的に残る
(
  # 0.05 秒ごとに描くので、回数は duration / 0.05 を四捨五入して 1 以上 (awk は macOS に標準。python3 の round は偶数丸めだが、
  # ちょうど .5 になる duration は 0.025 の奇数倍だけで、差は 1 回 = 0.05 秒)
  ticks=$(awk -v d="$duration" 'BEGIN { t = int(d / 0.05 + 0.5); if (t < 1) t = 1; print t }')
  i=0
  while [ "$i" -lt "$ticks" ]; do
    draw
    sleep 0.05
    i=$((i + 1))
  done
  tmux refresh-client 2>/dev/null || true
) &
