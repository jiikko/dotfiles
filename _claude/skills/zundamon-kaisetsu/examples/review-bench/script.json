  "lines": [
    {
      "who": "metan",
      "face": "説明",
      "chapter": "はじめに",
      "text": "今日は、パスワードを使い回さない理由について話すわ。"
    },
    {
      "who": "zundamon",
      "face": "考え中",
      "text": "使い回すと、何がまずいのだ？"
    },
    {
      "who": "metan",
      "face": "説明",
      "text": "1つのサービスから漏れたパスワードで、ほかのサービスにも入られてしまうの。",
      "show": {
        "type": "keyword",
        "text": "パスワードの使い回し",
        "sub": "1か所の漏洩が全部に広がる"
      }
    },
    {
      "who": "zundamon",
      "face": "驚き",
      "text": "それは怖いのだ！全部が危なくなるのだ。"
    },
    {
      "who": "zundamon",
      "face": "考え中",
      "chapter": "対策",
      "text": "じゃあ、どうすればいいのだ？"
    },
    {
      "who": "metan",
      "face": "説明",
      "text": "サービスごとに違うパスワードを作って、パスワードマネージャーに覚えさせるの。",
      "show": null
    },
    {
      "who": "metan",
      "face": "説明",
      "text": "覚えるのは、マネージャーを開くための四つの単語だけでいいわ。"
    },
    {
      "who": "metan",
      "face": "説明",
      "text": "さらに、ログインのときにパスワードに加えてスマートフォンに届く確認の番号も求める2段階認証を、使えるサービスでは全部有効にしておくと安心よ。"
    },
    {
      "who": "zundamon",
      "face": "考え中",
      "text": "2段階認証って、面倒じゃないのだ？"
    },
    {
      "who": "metan",
      "face": "説明",
      "text": "この図を見て。手間は最初の設定の1回だけなのよ。",
      "show": {
        "type": "compare",
        "left": {
          "title": "使い回し",
          "items": [
            "1か所の漏洩で全部"
          ]
        },
        "right": {
          "title": "別々＋認証",
          "items": [
            "被害は1か所で止まる"
          ]
        }
      }
    },
    {
      "who": "zundamon",
      "face": "笑顔",
      "text": "わたくしも、今日から設定するのだ。",
      "show": null
    },
    {
      "who": "zundamon",
      "face": "考え中",
      "chapter": "よくある誤解",
      "text": "使い回している人って、どれくらいいるのだ？"
    },
    {
      "who": "metan",
      "face": "説明",
      "text": "ある調査では、回答者の8割がパスワードを使い回していたの。"
    },
    {
      "who": "zundamon",
      "face": "驚き",
      "text": "そんなに多いのだ！"
    },
    {
      "who": "metan",
      "face": "説明",
      "text": "でも、2段階認証を入れれば、不正ログインは必ず防げるわ。",
      "show": {
        "type": "compare",
        "left": {
          "title": "対策なし",
          "items": [
            "1か所の漏洩で全部"
          ]
        },
        "right": {
          "title": "対策あり",
          "items": [
            "別々のパスワード",
            "スマホなら無料で使える"
          ]
        }
      }
    },
    {
      "who": "zundamon",
      "face": "考え中",
      "text": "SOLIDWORKSみたいな仕事のソフトでも同じなのだ？"
    },
    {
      "who": "metan",
      "face": "説明",
      "text": "ええ。Boot Campの上でも、仕事のソフトでも、考え方は同じよ。",
      "show": null
    },
    {
      "who": "metan",
      "face": "笑顔",
      "text": "今日の解説はここまでよ。最後まで見てくれてありがとう。"
    },
    {
      "who": "zundamon",
      "face": "笑顔",
      "text": "また見てほしいのだ！"
    }
  ]
